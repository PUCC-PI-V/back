enum Tamanho {
    Pequena
    Media   @map("Média")
    Grande
}
enum Area {
    Braco       @map("Braço")
    Antebraco   @map("Antebraço")
    Costela
    Cotovelo
    Barriga
    Panturrilha
    Cotas
    Cabeca      @map("Cabeça")
    Perna
    Mao         @map("Mão")
    Peitoral
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

generator db {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

model User {
    id       Int    @id @default(autoincrement())
    email    String @unique
    password String
}

model Descricao {
    id Int @id @default(autoincrement())
    tamanho Tamanho
    sombreamento Boolean
    colorido Boolean
    estilo String
    AreaTatuada Area
    RegiaoEspecifica String
    DesignAutoral Boolean
    Referencia Boolean
    Valor Float
    Complexidade String
}
enum Tamanho {
    Pequena
    Média
    Grande
}
enum Area {
    Braço
    Antebraço
    Costela
    Cotovelo
    Barriga
    Panturrilha
    Cotas
    Cabeça
    Perna
    Mão
    Peitoral
}

datasource db {
    provider = "mysql"
}

generator db {
  provider = "prisma-client-py"
  engineType = "binary"
  config_option = "value"
}

model Descricao {
    id Int @id @default(autoincrement())
    tamanho Tamanho
    sombreamento Boolean
    colorido Boolean
    estilo String
    AreaTatuada Area
    RegiaoEspecifica String
    DesignAutoral Boolean
    Referencia Boolean
    Valor Float
    Complexidade String
}